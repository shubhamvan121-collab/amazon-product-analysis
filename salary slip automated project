        "import pandas as pd\n",
        "from fpdf import FPDF\n",
        "import difflib\n",
        "import urllib.parse\n",
        "import ipywidgets as widgets\n",
        "from IPython.display import display, clear_output, HTML\n",
        "from google.colab import files\n",
        "\n",
        "# 1. Load Employee Database\n",
        "df = pd.read_excel(\"database.xlsx\")\n",
        "df.columns = df.columns.str.strip()\n",
        "net_col = \"Net_Salary\" if \"Net_Salary\" in df.columns else (\"Net Salary\" if \"Net Salary\" in df.columns else df.columns[9])\n",
        "\n",
        "# Smart Search (Case-insensitive + Partial + Related Match)\n",
        "def find_employee(query):\n",
        "    query = query.strip().lower()\n",
        "    if not query:\n",
        "        return None\n",
        "\n",
        "    ids = df[\"Emp_ID\"].astype(str).str.strip().str.lower()\n",
        "    names = df[\"Name\"].astype(str).str.strip().str.lower()\n",
        "\n",
        "    # Exact / partial match\n",
        "    mask = ids.str.contains(query, regex=False, na=False) | names.str.contains(query, regex=False, na=False)\n",
        "    if mask.any():\n",
        "        return df[mask].iloc[0]\n",
        "\n",
        "    # Related / spelling match\n",
        "    name_list = names.tolist()\n",
        "    close_names = difflib.get_close_matches(query, name_list, n=1, cutoff=0.45)\n",
        "    if close_names:\n",
        "        return df[names == close_names[0]].iloc[0]\n",
        "\n",
        "    for idx, full_name in enumerate(name_list):\n",
        "        if difflib.get_close_matches(query, full_name.split(), n=1, cutoff=0.6):\n",
        "            return df.iloc[idx]\n",
        "\n",
        "    id_list = ids.tolist()\n",
        "    close_ids = difflib.get_close_matches(query, id_list, n=1, cutoff=0.6)\n",
        "    if close_ids:\n",
        "        return df[ids == close_ids[0]].iloc[0]\n",
        "\n",
        "    return None\n",
        "\n",
        "# Generate PDF Salary Slip\n",
        "def create_pdf(emp):\n",
        "    month_val = emp[\"Month\"]\n",
        "    month_str = month_val.strftime(\"%b %Y\") if hasattr(month_val, \"strftime\") else str(month_val)\n",
        "\n",
        "    pdf = FPDF()\n",
        "    pdf.add_page()\n",
        "    pdf.set_font(\"Arial\", \"B\", 16)\n",
        "    pdf.cell(0, 12, f\"SALARY SLIP - {month_str}\", ln=True, align=\"C\")\n",
        "    pdf.ln(6)\n",
        "\n",
        "    rows = [\n",
        "        (\"Employee ID\", emp[\"Emp_ID\"]),\n",
        "        (\"Employee Name\", emp[\"Name\"]),\n",
        "        (\"Designation\", emp[\"Designation\"]),\n",
        "        (\"Email\", emp[\"Email\"]),\n",
        "        (\"Month\", month_str),\n",
        "        (\"Basic Salary\", f\"Rs. {emp['Basic']}\"),\n",
        "        (\"HRA\", f\"Rs. {emp['HRA']}\"),\n",
        "        (\"Allowance\", f\"Rs. {emp['Allowance']}\"),\n",
        "        (\"Deductions\", f\"Rs. {emp['Deductions']}\"),\n",
        "        (\"Net Payable Salary\", f\"Rs. {emp[net_col]}\"),\n",
        "    ]\n",
        "\n",
        "    for label, val in rows:\n",
        "        pdf.set_font(\"Arial\", \"B\" if label == \"Net Payable Salary\" else \"\", 12)\n",
        "        pdf.cell(65, 10, f\" {label}\", border=1)\n",
        "        pdf.cell(0, 10, f\" {val}\", border=1, ln=True)\n",
        "\n",
        "    file_name = f\"Salary_Slip_{emp['Name']}_{month_str}.pdf\".replace(\" \", \"_\")\n",
        "    pdf.output(file_name)\n",
        "    return file_name, month_str\n",
        "\n",
        "# Dashboard UI\n",
        "search_box = widgets.Text(\n",
        "    placeholder=\"Enter Employee ID or Name (e.g., emp101, shubham)...\",\n",
        "    description=\"🔍 Search:\",\n",
        "    layout=widgets.Layout(width=\"400px\")\n",
        ")\n",
        "btn_view = widgets.Button(description=\"📄 View Salary Slip\", button_style=\"info\", layout=widgets.Layout(width=\"195px\"))\n",
        "btn_send = widgets.Button(description=\"📧 Send to Gmail\", button_style=\"success\", layout=widgets.Layout(width=\"195px\"))\n",
